# Environment configuration for ReactorOS (Neon PostgreSQL)
# Copy this file to .env or .env.local and populate the values for your deployment

# Neon Serverless PostgreSQL Connection String (pooled connection recommended for serverless)
# Example: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct connection (optional, for migrations when using PgBouncer)
# DIRECT_URL="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Node Environment
NODE_ENV="development"

# Next.js Public Site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Telemetry Simulator Secret / Auth (for secure gateway ingestion)
GATEWAY_API_KEY="reactor-gw-dev-secret-key"
